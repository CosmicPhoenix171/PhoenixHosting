{
  "rules": {
    // =========================================================================
    // PHOENIX HOSTING - FIREBASE SECURITY RULES
    // =========================================================================
    // These rules enforce:
    // 1. Authentication required for most access
    // 2. Users can only see their own agents and servers
    // 3. Pairing system allows anonymous agent registration
    // 4. Data validation on all writes
    // =========================================================================

    // -------------------------------------------------------------------------
    // PING - Connection test (open for agents)
    // -------------------------------------------------------------------------
    "ping": {
      ".read": true,
      ".write": true
    },

    // -------------------------------------------------------------------------
    // PAIRING REQUESTS - Agent pairing codes
    // -------------------------------------------------------------------------
    "pairing_requests": {
      "$code": {
        // Anyone can read pairing requests (agent checks if paired)
        ".read": true,
        
        // Agent can create, authenticated user can update to paired
        ".write": true,
        
        ".validate": "newData.hasChild('agent_id') && newData.hasChild('status')"
      }
    },

    // -------------------------------------------------------------------------
    // AGENTS - Agent data and commands
    // -------------------------------------------------------------------------
    "agents": {
      // Authenticated users can list all agents (filtered client-side by user_id)
      ".read": "auth != null",
      
      "$agentId": {
        // Agent owner or the agent itself can read
        ".read": true,
        
        // Agent can write its own data
        ".write": true,
        
        "commands": {
          "$commandId": {
            // Commands can be created by authenticated users
            ".validate": "newData.hasChild('action')"
          }
        }
      }
    },

    // -------------------------------------------------------------------------
    // USERS - User profile data
    // -------------------------------------------------------------------------
    "users": {
      "$uid": {
        // Users can read/write their own profile
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },

    // -------------------------------------------------------------------------
    // SERVERS - Game server configuration and status (legacy)
    // -------------------------------------------------------------------------
    "servers": {
      "$serverId": {
        ".read": "auth != null && data.child('allowedUsers').child(auth.uid).val() == true",
        ".write": false
      },
      ".read": false,
      ".write": false
    },

    // -------------------------------------------------------------------------
    // COMMANDS - Command queue (legacy)
    // -------------------------------------------------------------------------
    "commands": {
      "$commandId": {
        ".read": "auth != null",
        ".write": "auth != null && !data.exists() && newData.exists()"
      },
      ".read": false,
      ".write": false
    },

    // -------------------------------------------------------------------------
    // AGENT STATUS (legacy)
    // -------------------------------------------------------------------------
    "agent": {
      "status": {
        ".read": "auth != null",
        ".write": false
      }
    },

    // -------------------------------------------------------------------------
    // DEFAULT - Deny all other access
    // -------------------------------------------------------------------------
    ".read": false,
    ".write": false
  }
}
