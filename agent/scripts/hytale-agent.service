[Unit]
Description=Hytale Server Manager Agent
Documentation=https://github.com/your-username/hytale-server-manager
After=network.target

[Service]
Type=simple
User=hytale
Group=hytale
WorkingDirectory=/opt/hytale-server-manager/agent

# Environment variables - EDIT THESE
Environment=NODE_ENV=production
Environment=LOG_LEVEL=INFO
Environment=CONFIG_PATH=/opt/hytale-server-manager/agent/config.json

# Secrets - Use systemd credentials or environment file for production
# Option 1: Direct (less secure)
# Environment=GITHUB_TOKEN=ghp_your_token_here
# Environment=COMMAND_SECRET=your_secret_here

# Option 2: Environment file (recommended)
EnvironmentFile=/opt/hytale-server-manager/agent/.env

ExecStart=/usr/bin/node agent.js
Restart=always
RestartSec=10
StandardOutput=append:/opt/hytale-server-manager/agent/logs/agent.log
StandardError=append:/opt/hytale-server-manager/agent/logs/agent-error.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/hytale-server-manager
ReadWritePaths=/opt/hytale-server

[Install]
WantedBy=multi-user.target
