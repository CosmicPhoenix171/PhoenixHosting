# Hytale Server Manager - .gitignore

# Environment and secrets
.env
.env.*
*.env
secrets.json

# Agent configuration (contains paths)
agent/config.json

# Logs
*.log
logs/
agent/logs/

# Node.js
node_modules/
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Backups (stored locally, not in repo)
backups/
*.zip
*.tar.gz

# PID files
*.pid

# Temporary files
tmp/
temp/
*.tmp

# Command files (these are transient)
commands/pending/*.json
commands/locked/*.json
# Keep done commands for history if desired
# commands/done/*.json
